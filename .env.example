# AI Model Radar Environment Variables

# Required: PostgreSQL Database URL. If omitted, local JSON file storage is used automatically.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_model_radar

# Optional: Custom OpenRouter API URL (defaults to https://openrouter.ai/api/v1/models)
OPENROUTER_API_URL=https://openrouter.ai/api/v1/models

# Required in production: Secret key to authorize cron job triggers (poll, prune, digest)
CRON_SECRET=your-cron-secret-here

# Required in production: Secret key to protect admin health dashboard
ADMIN_SECRET=your-admin-secret-here

# Required for Upstash Redis rate limiting (production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: GitHub personal access token for higher API rate limits (5000 req/hr vs 60)
GITHUB_TOKEN=

# Optional: Stripe billing integration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ENABLED=false

# Required in production (fail-loud on boot): Secret key for NextAuth.js session
# encryption (generate with: openssl rand -base64 32)
AUTH_SECRET=

# Public site URL — REQUIRED in production (used for RSS feeds, badges, canonical
# links, feed XML/JSON). No default is assumed in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Enable tier-based feature enforcement (Pro/Enterprise paywall). Defaults to false.
# Until Stripe billing is live, keep false so all tiers are accessible.
FEATURE_ENFORCEMENT=false

# Optional: From address for magic link authentication emails (default: AI Model Radar <auth@ai-model-radar.com>)
AUTH_EMAIL_FROM=

# Required for email digests via Resend
RESEND_API_KEY=

# Required for unsubscribe token verification
UNSUBSCRIBE_SECRET=

# Public site URL (used for RSS feed, badges, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Allow self-signed PostgreSQL certificates (last-resort override, default: false)
PGSSL_ALLOW_SELF_SIGNED=false

# Required in production (fail-loud on boot): Durable database. Local JSON file
# storage is used automatically only when this is omitted in non-production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_model_radar
