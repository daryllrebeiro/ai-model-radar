# AI Model Radar Environment Variables

# Required: PostgreSQL Database URL. If omitted, local JSON file storage is used automatically.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_model_radar

# Optional: Custom OpenRouter API URL (defaults to https://openrouter.ai/api/v1/models)
OPENROUTER_API_URL=https://openrouter.ai/api/v1/models

# Required in production: Secret key to authorize cron job triggers (poll, prune, digest)
CRON_SECRET=your-cron-secret-here

# Required in production: Secret key to protect admin health dashboard
ADMIN_SECRET=your-admin-secret-here

# Required for Upstash Redis rate limiting (production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: GitHub personal access token for higher API rate limits (5000 req/hr vs 60)
GITHUB_TOKEN=

# Optional: Stripe billing integration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ENABLED=false

# Required in production (fail-loud on boot): Secret key for NextAuth.js session
# encryption (generate with: openssl rand -base64 32)
AUTH_SECRET=

# Public site URL — REQUIRED in production (used for RSS feeds, badges, canonical
# links, feed XML/JSON). No default is assumed in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Enable tier-based feature enforcement (Pro/Enterprise paywall). Defaults to false.
# Until Stripe billing is live, keep false so all tiers are accessible.
FEATURE_ENFORCEMENT=false

# Optional: From address for magic link authentication emails (default: AI Model Radar <auth@ai-model-radar.com>)
AUTH_EMAIL_FROM=

# Required for email digests via Resend
RESEND_API_KEY=

# Required for unsubscribe token verification
UNSUBSCRIBE_SECRET=

# Optional: Allow self-signed PostgreSQL certificates (last-resort override, default: false)
PGSSL_ALLOW_SELF_SIGNED=false

# Optional: CORS allowlist for the public API (comma-separated origins).
# A matching request Origin is echoed back with `Vary: Origin`; anything else
# falls back to `Access-Control-Allow-Origin: *` for the public unauthenticated
# catalog surface. No cross-origin credentials are ever accepted, so the
# wildcard fallback cannot exfiltrate sessions.
ALLOWED_ORIGINS=https://app.example.com

# Required to store third-party connector tokens (R8): AES-256-GCM key-encrypting
# key for export_connectors.secret (any high-entropy string; SHA-256'd to 32 bytes).
# Without it, secret-bearing connector registration is refused (fail-closed).
# NOT stored in the database — lives only in the deployment secret store.
EXPORT_CONNECTOR_KEY=

# R10 routing gateway pilot (all deny-by-default; unset = disabled).
# ROUTING_ENABLED=true plus membership in ROUTING_PILOT_ALLOWLIST (comma-separated
# emails) plus a per-user opt-in row are ALL required before routing serves traffic.
ROUTING_ENABLED=false
ROUTING_PILOT_ALLOWLIST=
# Upstream OpenAI-compatible endpoint + key used for proxied forwarding.
# Without ROUTING_UPSTREAM_KEY the gateway answers 503 (fail-closed, explicit).
ROUTING_UPSTREAM_BASE=https://openrouter.ai/api/v1
ROUTING_UPSTREAM_KEY=

# R9 ingestion connectors: reviewed connectors run only when allowlisted here
# (comma-separated keys, e.g. CONNECTORS_ALLOWLIST=replicate). Never auto-polled.
CONNECTORS_ALLOWLIST=
