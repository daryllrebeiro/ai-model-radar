{
  "crons": [
    {
      "path": "/api/cron/poll",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/probes",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/digest",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/digest?timeframe=weekly",
      "schedule": "0 8 * * 1"
    }
  ]
}
